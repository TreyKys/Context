{
  "name": "context-dictionary-ad",
  "version": "1.0.0",
  "description": "Bright, Apple-style motion ad for The Context Dictionary (Remotion)",
  "scripts": {
    "start": "remotion studio",
    "render": "remotion render ContextAd out/context-ad.mp4",
    "render:4": "remotion render ContextAd4 out/context-ad-4-room-9x16.mp4",
    "render:5": "remotion render ContextAd5 out/context-ad-5-meeting-16x9.mp4",
    "render:6": "remotion render ContextAd6 out/context-ad-6-rooms-9x16.mp4",
    "render:7": "remotion render ContextAd7 out/context-ad-7-vsgoogle-9x16.mp4",
    "render:cream": "npm run render:4 && npm run render:5 && npm run render:6 && npm run render:7",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.5.4"
  }
}
