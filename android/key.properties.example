# Copy this file to `key.properties` in this same folder (android/) and fill in
# the real values. `key.properties` and *.jks are git-ignored — never commit them.
#
# 1) Create the keystore (from anywhere), choosing passwords when prompted:
#      keytool -genkey -v -keystore $HOME/context-upload.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# 2) Get its absolute path:  echo $HOME/context-upload.jks
# 3) Fill in below.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
# Must be an ABSOLUTE path (a leading ~ is NOT expanded here):
storeFile=/home/USER/context-upload.jks
